{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenKakao Jarvis",
  "version": "0.1.0",
  "identifier": "com.openkakao.auto-reply.menu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "jarvis",
        "title": "",
        "url": "index.html",
        "width": 276,
        "height": 260,
        "minWidth": 276,
        "minHeight": 260,
        "maxWidth": 276,
        "maxHeight": 260,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Jarvis 설정",
        "url": "index.html?view=settings",
        "width": 760,
        "height": 760,
        "minWidth": 600,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
