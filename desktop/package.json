{
  "name": "openkakao-jarvis-desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "bench:render": "esbuild src/perf/render-path-node.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/render-path-bench.mjs --log-level=warning && node node_modules/.cache/render-path-bench.mjs",
    "tauri": "tauri",
    "smoke": "sh scripts/smoke.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.180.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0"
  }
}
